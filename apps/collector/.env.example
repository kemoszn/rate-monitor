# Collector server (existing /extract route)
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
PLAYWRIGHT_HEADLESS=true
OPENAI_API_KEY=
STAGEHAND_MODEL_NAME=openai/gpt-4.1-mini
STAGEHAND_HEADLESS=true
STAGEHAND_VERBOSE=0
EXTRACT_TIMEOUT_MS=45000
NAVIGATION_TIMEOUT_MS=30000
RETRY_ATTEMPTS=2
RETRY_BASE_DELAY_MS=750
DEBUG_MODE=false
DEBUG_ARTIFACTS_DIR=./debug-artifacts
DISCOVERY_ARTIFACTS_DIR=./discovery-artifacts
DEFAULT_SOURCE_URL=https://example.com

# === collect:once cron (apps/collector/src/cli/collectAll.ts) ===

# Turso (libSQL) database. URL is required.
# For local dev use a file: URL, e.g. file:./data/dev.db
# For prod use the libsql:// URL provided by Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Provider config: JSON-encoded ExchangeHouseProviderDefinition[].
# When unset, falls back to the array exported from packages/shared.
PROVIDER_CONFIG_JSON=

# Quote currencies (comma-separated). Defaults to SUPPORTED_CURRENCIES.
QUOTE_CURRENCIES=INR,PKR,NPR
BASE_CURRENCY=AED

# Slack webhooks (optional). Rate webhook receives per-run rate summaries;
# ops webhook receives failure pings (workflow crashes, ≥N provider failures).
SLACK_RATE_WEBHOOK_URL=
SLACK_OPS_WEBHOOK_URL=
SLACK_REQUEST_TIMEOUT_MS=10000

# Google Finance benchmark.
GOOGLE_FINANCE_BASE_URL=https://www.google.com/finance/quote
GOOGLE_FETCH_TIMEOUT_MS=15000
GOOGLE_USER_AGENT=

# Exit code threshold: if provider failures ≥ this, the run exits non-zero so
# CI shows red. Single transient failures don't spam.
FAILURE_EXIT_THRESHOLD=3

# Geo lookup: when true, calls ipapi.co at startup to detect runner geo and
# aligns Node TZ + browser timezone/locale/geolocation to it. Disable with
# GEO_LOOKUP_ENABLED=false to keep deterministic behavior in tests.
GEO_LOOKUP_ENABLED=true

# Optional residential-proxy upgrade path. When set, Playwright launches via
# this proxy. Geo detection should be re-run through the proxy in that case.
# HTTP_PROXY=http://proxy.example.com:8080
# PROXY_USER=
# PROXY_PASS=
